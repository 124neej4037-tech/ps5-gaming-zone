# Server Configuration
PORT=5000
NODE_ENV=development

# Initial Admin Email for auto-role assignment
INITIAL_ADMIN_EMAIL=admin@gmail.com

# Google Gemini API Key for conversational AI game recommendations (optional, smart fallback included)
GEMINI_API_KEY=

# Firebase Admin SDK Configuration (Option 1: Individual Environment Variables)
FIREBASE_PROJECT_ID=bandhilki-ps5
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Admin SDK Configuration (Option 2: Path to downloaded Service Account JSON file)
# FIREBASE_SERVICE_ACCOUNT_KEY=./config/serviceAccountKey.json
